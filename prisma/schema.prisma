generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Occasion {
  BIRTHDAY
  ANNIVERSARY
  APOLOGY
  THANK_YOU
  SYMPATHY
  WEDDING
  JUST_BECAUSE
}

enum Palette {
  PASTEL
  BRIGHT
  WHITE
  WARM
}

enum BouquetSize {
  CLASSIC
  DELUXE
  GRAND
}

model Product {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  description String
  imageUrl    String
  imageAlt    String
  palette     Palette
  occasions   Occasion[]
  featured    Boolean          @default(false)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductVariant {
  id         String      @id @default(cuid())
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  size       BouquetSize
  stems      Int
  priceCents Int

  @@unique([productId, size])
}
